// Zed — tareas globales. Se lanzan con "space l ...", "space f ...", "-" y
// "space g g" (ver keymap.json), o con la paleta: `task: spawn`.
//
// Este archivo faltaba por completo, y con el faltaban las seis tareas que el
// keymap ya invocaba: un task::Spawn cuyo task_name no existe no hace nada ni
// avisa. Los nombres de aqui y los del keymap tienen que coincidir letra a
// letra.
//
// Variables: $ZED_FILE, $ZED_DIRNAME, $ZED_STEM, $ZED_FILENAME, $ZED_ROW,
// $ZED_COLUMN, $ZED_WORKTREE_ROOT. Tambien admiten valor por defecto con
// ${ZED_LOQUESEA:valor}.
[
  // ─── LaTeX ──────────────────────────────────────────────────────────────
  // texlab NO compila al guardar (el porque, largo, esta en settings.json).
  // Compilar y ver el PDF se hace desde aqui, que es lo unico que respeta el
  // Makefile de cada paper.
  {
    // Busca un Makefile subiendo desde la carpeta del .tex y lo usa. Es lo que
    // manda en ~/repositorios/work/papers-project: sus papers resuelven la
    // clase por TEXINPUTS y borran los intermedios al terminar, dos cosas que
    // un latexmk suelto no haria. Sin Makefile, cae a latexmk.
    "label": "LaTeX: compilar",
    "command": "d=\"$ZED_DIRNAME\"; while [ \"$d\" != \"/\" ] && [ ! -f \"$d/Makefile\" ]; do d=$(dirname \"$d\"); done; if [ -f \"$d/Makefile\" ]; then echo \"make en $d\"; cd \"$d\" && make; else echo 'sin Makefile: latexmk'; cd \"$ZED_DIRNAME\" && latexmk -e '$pdf_mode = 1 unless $pdf_mode != 0;' -interaction=nonstopmode -synctex=1 -f \"$ZED_FILE\"; fi",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus"
  },
  {
    // Busqueda directa: abre el PDF en la linea donde esta el cursor. El -x
    // deja armada la inversa, de modo que un clic en el PDF vuelve a Zed.
    // El PDF se busca en build/ (convencion de los papers) antes que al lado
    // del fuente; para letters/*.tex el build/ esta un nivel mas arriba.
    "label": "LaTeX: ver el PDF en esta linea",
    "command": "p=''; for c in \"$ZED_DIRNAME/build/$ZED_STEM.pdf\" \"$ZED_DIRNAME/../build/$ZED_STEM.pdf\" \"$ZED_DIRNAME/$ZED_STEM.pdf\"; do if [ -f \"$c\" ]; then p=\"$c\"; break; fi; done; if [ -z \"$p\" ]; then echo \"no encuentro el PDF de $ZED_STEM -- compila primero con space l b\"; exit 1; fi; echo \"abriendo $p\"; zathura --synctex-forward \"$ZED_ROW:$ZED_COLUMN:$ZED_FILE\" -x \"zeditor %{input}:%{line}\" \"$p\" >/dev/null 2>&1 &",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "no_focus"
  },
  {
    // Solo para un .tex suelto: con Makefile, `make` ya es incremental.
    "label": "LaTeX: compilar en continuo",
    "command": "cd \"$ZED_DIRNAME\" && latexmk -pvc -view=none -e '$pdf_mode = 1 unless $pdf_mode != 0;' -interaction=nonstopmode -synctex=1 \"$ZED_FILE\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "LaTeX: limpiar auxiliares",
    "command": "d=\"$ZED_DIRNAME\"; while [ \"$d\" != \"/\" ] && [ ! -f \"$d/Makefile\" ]; do d=$(dirname \"$d\"); done; if [ -f \"$d/Makefile\" ]; then cd \"$d\" && make clean; else cd \"$ZED_DIRNAME\" && latexmk -c \"$ZED_FILE\"; fi",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "LaTeX: contar palabras",
    "command": "texcount -inc -sum -brief \"$ZED_FILE\"",
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },

  // ─── Navegacion ─────────────────────────────────────────────────────────
  {
    "label": "Yazi",
    // EDITOR se fija aqui para que abrir un archivo desde yazi vuelva a Zed
    // y no arranque un nvim dentro del panel.
    "command": "EDITOR=zeditor yazi \"$ZED_WORKTREE_ROOT\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "File Finder",
    "command": "f=$(fd --type f --hidden --exclude .git | fzf --preview 'bat --color=always --style=numbers {}') && [ -n \"$f\" ] && zeditor \"$f\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Find Directories",
    "command": "d=$(fd --type d --hidden --exclude .git | fzf --preview 'ls -la {}') && [ -n \"$d\" ] && zeditor \"$d\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    // rg + fzf en vivo: cada tecla relanza la busqueda. El {1} y {2} salen de
    // los campos que separa el ':' en la linea de rg (archivo y numero).
    "label": "Find in Files",
    "command": "f=$(rg --line-number --no-heading --color=always --smart-case '' | fzf --ansi --delimiter : --preview 'bat --color=always --style=numbers --highlight-line {2} {1}' --preview-window '+{2}-/2') && [ -n \"$f\" ] && zeditor \"$(echo \"$f\" | cut -d: -f1):$(echo \"$f\" | cut -d: -f2)\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },

  // ─── Otros ──────────────────────────────────────────────────────────────
  {
    "label": "Lazygit",
    "command": "lazygit",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Obsidian",
    "command": "obsidian &",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "no_focus"
  }
]
