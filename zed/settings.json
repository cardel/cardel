// Zed — configuracion. El porque de cada bloque esta en zed/README.md.
//
// Los ajustes por defecto se ven con `zed: open default settings` desde la
// paleta de ordenes (ctrl-shift-p). Este archivo solo lleva lo que difiere.
{
  // ─── Extensiones ──────────────────────────────────────────────────────
  // Zed instala solas las que falten al arrancar. Esta lista es lo que hace
  // reproducible una maquina nueva: sin ella un clon se queda sin texlab y
  // sin corrector, y el bloque "lsp" de mas abajo no aplica a nada.
  "auto_install_extensions": {
    "latex": true,
    "ltex": true,
    // Solo para colorear el codigo mermaid: DIBUJAR los diagramas ya lo hace
    // Zed por su cuenta, con un crate propio (mermaid_render) y aplicando el
    // tema del editor. La vista previa de Markdown los muestra sin instalar
    // nada.
    "mermaid": true,
    "dockerfile": true,
    "html": true,
    "log": true
  },

  // ─── Paneles ──────────────────────────────────────────────────────────
  "toolbar": { "quick_actions": false },
  "project_panel": { "dock": "left", "indent_size": 12 },
  "outline_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },

  // ─── Vim ──────────────────────────────────────────────────────────────
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 150
  },
  "use_smartcase_search": true,
  // Sin autoguardado: mas abajo el guardar dispara la compilacion de LaTeX,
  // y con autosave se compilaria en cada pausa de tecleo.
  "autosave": "off",

  // ─── Tipografia y tema ────────────────────────────────────────────────
  "ui_font_size": 16,
  "buffer_font_size": 16,
  // No existe "agent_font_size" — Zed solo conoce estas dos. La otra llevaba
  // tiempo en el archivo sin hacer nada.
  "agent_ui_font_size": 16,
  "agent_buffer_font_size": 16,
  "ui_font_family": "IosevkaTerm Nerd Font",
  "buffer_font_family": "IosevkaTerm Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "Kanagawa Lotus",
    "dark": "Gentleman Kanagawa Blur"
  },

  "terminal": {
    "shell": "system",
    "line_height": { "custom": 1.25 }
  },

  "diagnostics": {
    "inline": { "enabled": true }
  },
  "soft_wrap": "editor_width",

  // ─── Copilot ──────────────────────────────────────────────────────────
  "show_edit_predictions": true,
  // Antes esto era "features": { "edit_prediction_provider": ... }. Zed lo
  // movio aqui (migracion m_2026_02_02) y avisa del cambio con una
  // notificacion, no con un error: el ajuste viejo se sigue leyendo, asi que
  // nada parece roto mientras tanto.
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "version": "2"
  },

  // ─── Ajustes por lenguaje ─────────────────────────────────────────────
  //
  // Zed trae un trato de "prosa" para Markdown, Plain Text y Git Commit, pero
  // NO para LaTeX: su bloque por defecto solo fija el formateador y el
  // servidor. Aqui se le da el mismo trato, que es lo que corresponde a un
  // lenguaje que es 90% texto corrido.
  //
  // Las 80 columnas no son un numero redondo elegido al azar: es a lo que
  // esta escrito el material. En main.tex, 1201 de 1247 lineas no vacias
  // caben en 80, y la mediana es 70. Los .md del workspace dan p90 entre
  // 76 y 82.
  "languages": {
    "LaTeX": {
      "soft_wrap": "editor_width",
      "tab_size": 2,
      "preferred_line_length": 80,
      "wrap_guides": [80],

      // Lo que hace que "gq" funcione. Por defecto LaTeX hereda
      // allow_rewrap = "in_comments", y en el codigo de Zed eso es literal:
      //   InComments => inside_comment
      // o sea que gqip sobre un parrafo no hace absolutamente nada, y solo
      // reflui­ria dentro de un comentario con %.
      "allow_rewrap": "anywhere",

      // Guardar no debe reescribir lineas que no se tocaron. Con el valor por
      // defecto (true), abrir y guardar cualquiera de los 28 archivos del
      // workspace que tienen espacios finales produce un diff de lineas
      // ajenas, en manuscritos que van firmados por varias personas. Zed ya
      // hace esta excepcion con Markdown y con Diff.
      "remove_trailing_whitespace_on_save": false,

      // El formateo al vuelo estorba en prosa; mismo criterio que Markdown.
      "use_on_type_format": false,

      // Sin esto, el menu se llena de palabras sacadas del propio buffer y
      // tapa lo util, que son las de texlab (\cite, \ref, \label) y Copilot.
      "completions": { "words": "disabled" },

      // latexindent llega con texlive-binextra; hasta entonces formatear al
      // guardar seria un error silencioso en cada guardado.
      "format_on_save": "off"
    },
    "BibTeX": {
      "tab_size": 2,
      "remove_trailing_whitespace_on_save": false,
      "format_on_save": "off"
    },
    "Markdown": {
      // allow_rewrap, soft_wrap, use_on_type_format, completions.words y
      // remove_trailing_whitespace_on_save ya vienen bien de fabrica. Solo
      // falta la medida.
      "preferred_line_length": 80,
      "wrap_guides": [80],
      "format_on_save": "off"
    },
    "Plain Text": {
      "preferred_line_length": 80,
      "wrap_guides": [80]
    }
  },

  // ─── Servidores de lenguaje ───────────────────────────────────────────
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          // build.executable se deja SIN poner a proposito. La extension
          // rellena entonces su propio preajuste de latexmk, que respeta el
          // .latexmkrc del proyecto (para xelatex, $pdf_mode = 5). Fijar
          // aqui "latexmk -pdf" pisaria ese archivo y forzaria pdflatex.
          // Compilar al guardar queda APAGADO, y no por gusto.
          //
          // Guardar es el unico disparador de compilacion que texlab ofrece a
          // Zed, asi que encenderlo es la unica forma de que texlab compile.
          // Pero lo hace con latexmk, en la carpeta del .tex, y eso choca de
          // frente con como esta montado ~/repositorios/work/papers-project:
          //
          //   - Sus papers resuelven la clase (infedu.cls) por TEXINPUTS desde
          //     template/. Sin esa variable, latexmk no encuentra la clase y
          //     falla en CADA guardado. Comprobado con kpsewhich.
          //   - Su regla 4.4 exige que nada se escriba junto a las fuentes y
          //     que los intermedios se borren al terminar cada build. latexmk
          //     hace lo contrario: deja .fdb_latexmk y auxiliares para poder
          //     compilar incremental.
          //
          // Asi que la compilacion va por las tareas de "space l b", que usan
          // el Makefile del paper cuando lo hay. Y la busqueda directa la hace
          // "space l v" llamando a zathura por su cuenta, sin pasar por texlab.
          //
          // Para un .tex suelto, sin Makefile, encender esto es comodo: se
          // pone a true en el .zed/settings.json de ese proyecto, no aqui.
          "build": {
            "onSave": false,
            "forwardSearchAfter": false
          },
          // Solo entra en juego si algun proyecto enciende build.onSave en su
          // .zed/settings.json; con onSave apagado, quien abre el PDF es la
          // tarea "LaTeX: ver el PDF en esta linea".
          //
          // Puesto a mano en vez de dejar que la extension lo detecte: su
          // deteccion prueba evince ANTES que zathura, y evince gana siempre
          // aqui aunque zathura este instalado. Ver zed/README.md.
          //   %f fichero fuente   %l linea   %p pdf   %% un % literal
          "forwardSearch": {
            "executable": "zathura",
            "args": [
              "--synctex-forward",
              "%l:1:%f",
              "-x",
              "zeditor %%{input}:%%{line}",
              "%p"
            ]
          },
          // texlab trae chktex desactivado de fabrica. onEdit lo lanza en
          // cada pulsacion, que en un documento largo se nota; con abrir y
          // guardar basta.
          "chktex": {
            "onOpenAndSave": true,
            "onEdit": false
          }
        }
      }
    },
    "ltex": {
      "settings": {
        "ltex": {
          // Corrector gramatical. Para un documento en ingles no hay que
          // tocar nada aqui: basta una linea magica en el propio .tex,
          //   % LTeX: language=en-US
          "language": "es",
          "additionalRules": {
            "motherTongue": "es"
          },
          // Palabras que LanguageTool no conoce. Crece a mano: Zed no puede
          // escribir la accion rapida de "anadir al diccionario".
          "dictionary": {
            "es": [
              "Hyprland",
              "Wayland",
              "Arch",
              "framework",
              "software",
              "hardware"
            ]
          }
        }
      }
    }
  }
}
