{
  "hyprland/workspaces": {
    "format": "{name}",
    // Solo los escritorios que existen, y solo los de ESTA pantalla.
    //
    // Las dos cosas son a proposito y se probaron al reves primero:
    //
    //   persistent-workspaces fijaba 1..5 siempre. Quitado: molesta mas de lo
    //   que ayuda, porque pinta escritorios vacios que no se estan usando.
    //
    //   all-outputs=true hacia que cada barra mostrara los escritorios de
    //   TODAS las salidas. Con dos pantallas eso significa dos barras con los
    //   mismos numeros, lo que hace imposible ver de un vistazo en cual estas.
    //   Con false (el valor de fabrica) cada barra filtra por su monitor:
    //   medido con DP-1 en el escritorio 1 y eDP-1 en el 2, cada barra muestra
    //   el suyo.
    //
    // waybar crea una barra por salida, asi que esto se aplica a cada una.
    "all-outputs": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },
  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio#microphone"
    ]
  },
  "clock": {
    "format": " {:%R}",
    "tooltip-format": "{calendar}",
    "format-alt": " {:%A, %d %B, %R}"
  },
  "hyprland/window": {
    "format": "{}",
    "separate-outputs": true,
    "rewrite": {
      "win11(.*)": " ",
      "(.*) - Rnote$": " ",
      "(.*) - Brave$": " $1",
      "(.*) - qutebrowser$": " $1",
      "nvim (.*)": "  $1",
      "nvim": " ",
      "System Monitor": " ",
      "Eye of GNOME": " ",
      "Catfish": " ",
      "Bluetooth Devices": " ",
      "Network Connections": " ",
      "nmtui(.*)": " ",
      "pulsemixer": " ",
      "Volume Control": " ",
      "ROG Control Center": "󰌢 ",
      "Audacity": "󰋌 ",
      "Qalculate!": "󰃬 ",
      "Krita": " ",
      "Lutris": " ",
      "uGet": " ",
      "nvtop": "󰡁 ",
      "wdisplays": "󱎴 ",
      "vim (.*)": "  $1",
      "vim": "",
      "vi (.*)": "  $1",
      "vi": " ",
      "cava(.*)": " ",
      "nwg-look": " ",
      "Kvantum Manager": " ",
      "Customize Look and Feel": " ",
      "Qt5 Configuration Tool": " ",
      "Qt6 Configuration Tool": " ",
      "Virtual Machine Manager": " ",
      "MySQL Workbench": " ",
      "htop(.*)": " ",
      "btop(.*)": " ",
      "~(.*)": " ",
      "/(.*)": " ",
      "yazi(.*)": "󰉋 $1",
      "(.*)Steam": "󰓓 ",
      "bluetuith": " "
    },
    "max-length": 50
  },
  "pulseaudio": {
    "format": "{icon} {volume}% ",
    "format-muted": "  ",
    "format-icons": {
      "default": [
        "🔈",
        "🔉",
        "🔊"
      ]
    },
    "scroll-step": 5.0,
    "on-click": "$TERMINAL --app-id floating -e pulsemixer || $TERMINAL -e pulsemixer",
    "on-click-right": "volume.sh --toggle",
    "on-scroll-up": "volume.sh --inc",
    "on-scroll-down": "volume.sh --dec",
    "tooltip-format": "{icon} {desc} | {volume}% ",
    "smooth-scrolling-threshold": 1
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "🎙️ {volume}%",
    "format-source-muted": " ",
    "on-click": "$TERMINAL --app-id floating -e pulsemixer || $TERMINAL -e pulsemixer",
    "on-click-right": "volume.sh --toggle-mic",
    "on-scroll-up": "volume.sh --inc-mic",
    "on-scroll-down": "volume.sh --dec-mic",
    "tooltip": false,
    "smooth-scrolling-threshold": 1
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },
  "battery": {
    "format": "{icon} {capacity}% ",
    "format-icons": [
      "🪫",
      "🔋"
    ],
    "format-time": "{H}h{M}m",
    "format-charging": "⚡ {capacity}% ",
    "format-not-charging": "⚡ {capacity}% ",
    "tooltip": "{time}",
    "interval": 30,
    "on-click-right": "actions.sh power",
    "states": {
      "warning": 30,
      "critical": 10
    }
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "{essid}({frequency} GHz) ({signalStrength}%)  ",
    "format-ethernet": "{ifname} 🌐",
    "format-disconnected": "",
    "tooltip-format": "{ipaddr}/{cidr}\n{ifname} via {gwaddr}",
    "on-click": "$TERMINAL --app-id=floating --title=nmtui -e nmtui || $TERMINAL -e nmtui",
    "on-click-right": "networkmanager_dmenu -w 35",
    "max-length": 50
},
  "custom/separator": {
    "format": " | ",
    "interval": "once",
    "tooltip": false
  }
}
